# URL-safe password; secrets never belong in Git.
DB_PASSWORD=replace_with_random_url_safe_password
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
# mock | sandbox | live. Start with mock. Live needs explicit LIVE_CARGO_ENABLED=true.
CARRIER_MODE=mock
LIVE_CARGO_ENABLED=false
DHL_CLIENT_ID=
DHL_CLIENT_SECRET=
DHL_CUSTOMER_NUMBER=
DHL_PASSWORD=
# Optional PDF conversion sends only ZPL labels to Labelary.
LABELARY_ENABLED=false
# Optional normalized HTTPS carrier gateway, useful for IP allowlisting.
CARRIER_GATEWAY_URL=
CARRIER_GATEWAY_TOKEN=
WHATSAPP_REACTION_URL=
WHATSAPP_REACTION_TOKEN=
INGEST_TOKEN=
